APP_NAME="Sufra GroupOps"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
# your website address, e.g. https://ops.sufrafood.com (no / at the end)
APP_URL=https://YOUR-DOMAIN.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# hPanel → Databases → MySQL Databases (names look like u123456789_sufra)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_sufra
DB_USERNAME=u000000000_sufra
DB_PASSWORD=CHANGE_ME

# POS cashiers stay logged in for a full shift (12 hours)
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# logos, product photos and proof photos are saved straight into public/storage (no symlink needed)
UPLOADS_IN_PUBLIC=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@YOUR-DOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"
